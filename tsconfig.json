{
	"compilerOptions": {
		"rootDir": "src",
		"outDir": "lib",
		"module": "node16",
		"moduleResolution": "node16",
		"target": "es2022",
		"sourceMap": true,
		"declaration": true,
		"forceConsistentCasingInFileNames": true,
		"noImplicitReturns": true,
		"importHelpers": true,
		"strict": true,
		"strictFunctionTypes": false,
		"strictPropertyInitialization": false,
		"noUnusedLocals": true,
		"experimentalDecorators": true,
		"types": ["node"]
	},
	"exclude": ["node_modules", "lib"]
}
